  {
    "name": "an_graph_submit",
    "description": "Atomically append task nodes against base_revision. Replay the same idempotency key and content for the original receipt. A stale base returns the current revision. New nodes may consume earlier immutable outputs or task inputs. Host permissions are separate from panel responses.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "integer"
        },
        "idempotency_key": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "run",
                  "expand",
                  "model",
                  "surface",
                  "delivery"
                ]
              },
              "model": {
                "type": "string",
                "description": "Granted host model alias"
              },
              "continuation": {
                "type": "string",
                "description": "Expand node authorized to consume the provisional response and propose the designated saver."
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "node": {
                          "type": "string"
                        },
                        "port": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "node",
                        "port"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "input": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "input"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Run output paths, surface [\"response\"] or [\"response\",\"document\"], or empty for deliveries."
              },
              "spool": {
                "type": "string",
                "description": "Granted digest-pinned image for a run."
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "panel": {
                "type": "string",
                "description": "Panel ID declared by the task-authorized spool. Bind inputs by declared name."
              },
              "save": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string"
                  },
                  "port": {
                    "type": "string"
                  }
                },
                "required": [
                  "node",
                  "port"
                ],
                "additionalProperties": false,
                "description": "Optional container output confirming a saved document. The designated run must consume this surface response."
              }
            },
            "required": [
              "id",
              "kind",
              "outputs"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "retry": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instruction_cursor": {
          "type": "integer",
          "description": "Cursor of the current user instruction that prompted this submission."
        },
        "supersede": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "base_revision",
        "idempotency_key",
        "nodes"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "an_graph_state",
    "description": "Read current nodes, attempts, turn_scopes with reviewed route decisions, and events following a cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "after": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "an_scope_propose",
    "description": "Before submitting a graph for a new instruction, propose the minimal turn routes for the person to review in Studio. Each route has operation, origin, source, destination. Use source.input for a named task input, source.node and source.port for an exact output, or source.producer_port and producer_argv for recurring immutable spool outputs. Name graph-metadata for subgraph publication and model:<granted alias> for model inputs. For a follow-up on the same turn, give the latest user instruction_cursor and propose only additional routes. Only the person can approve.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "operation": {"type": "string", "enum": ["input", "handoff", "publish", "preview", "model"], "description": "input sends a task input to a spool. handoff sends a produced artifact to another spool. publish sends an artifact to the catalog delivery_destination or graph-metadata. preview sends to studio. model sends to model:<alias>."},
              "origin": {"type": "string", "description": "For a task input use task-input:<exact input filename>. For a spool output copy the full producer spool key from an_catalog. Model outputs use model:<alias>, surface responses use response."},
              "destination": {"type": "string", "description": "For input and handoff copy the exact recipient spool key, without any prefix or port suffix. For delivery copy delivery_destination from an_catalog."},
              "source": {
                "type": "object",
                "properties": {"input": {"type": "string"}, "node": {"type": "string"}, "port": {"type": "string"}, "producer_port": {"type": "string"}},
                "oneOf": [{"required":["input"],"maxProperties":1},{"required":["node","port"],"maxProperties":2},{"required":["producer_port"],"maxProperties":1}],
                "additionalProperties": false
              },
              "producer_argv": {"type":"array","minItems":1,"items":{"type":"string"},"description":"Include the full command on EVERY spool output route, including source.node + source.port. Copy argv from the existing producer node or its skill. Without argv an exact node rule still requires an individual decision. Omit for task inputs."}
            },
            "required": ["operation","origin","destination","source"],
            "additionalProperties": false
          }
        },
        "instruction_cursor": {"type": "integer", "minimum": 1}
      },
      "required": ["routes"],
      "additionalProperties": false
    }
  },
  {
    "name": "an_graph_say",
    "description": "Post a message to the person in the task timeline. Use for progress, a question or a result; ask for decisions with surfaces instead. Pass reply_to with an instruction's event cursor when answering it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "purpose": {"type": "string", "enum": ["progress", "question", "result"]},
        "reply_to": {"type": "integer"},
        "idempotency_key": {"type": "string"}
      },
      "required": ["text", "idempotency_key"],
      "additionalProperties": false
    }
  }
]
