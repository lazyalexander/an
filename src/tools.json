  {
    "name": "an_run",
    "description": "Run guest argv on a loaded instance. Supply its instance ID, or its loaded spool reference. Input is an input name or delivered run ID. Declare paths relative to /output. Returns run ID. For named ports supply inputs as a mapping of port to source. Retry a pending port using input_requests mapping that port to its approved request ID, retaining earlier IDs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "spool": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_id": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "input_requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    }
  },
  {
