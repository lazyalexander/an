{
  "instance": "bridge-studio",
  "title": "Bridge Studio",
  "stages": [
    {
      "id": "import",
      "label": "导入",
      "kind": "headless"
    },
    {
      "id": "pose",
      "label": "位姿",
      "kind": "interaction",
      "surface": "adjust"
    },
    {
      "id": "render",
      "label": "渲染",
      "kind": "headless"
    },
    {
      "id": "archive",
      "label": "建档",
      "kind": "artifact"
    }
  ],
  "surfaces": [
    {
      "id": "adjust",
      "label": "调姿",
      "kind": "native",
      "app": "Blender",
      "phase": "ADJUSTMENT",
      "inputs": [
        "pointer"
      ]
    },
    {
      "id": "paint",
      "label": "绘画",
      "kind": "native",
      "app": "Krita",
      "phase": "LOCKED",
      "inputs": [
        "pen",
        "decision"
      ]
    }
  ],
  "decisions": [
    {
      "kind": "adopt_or_rerender",
      "label": "采用或重渲",
      "actions": [
        {
          "action": "adopt",
          "label": "采用",
          "style": "primary"
        },
        {
          "action": "rerender",
          "label": "重渲",
          "force_when_adapter_down": true
        }
      ]
    },
    {
      "kind": "retry",
      "label": "重试",
      "actions": [
        {
          "action": "retry",
          "label": "重试",
          "role": "retry"
        }
      ]
    }
  ],
  "drawer": [
    {
      "id": "poses",
      "label": "位姿历史",
      "kinds": [
        "pose_stream"
      ],
      "format": "summary"
    },
    {
      "id": "snapshots",
      "label": "快照",
      "kinds": [
        "file_drop",
        "import_done"
      ],
      "format": "summary"
    },
    {
      "id": "failures",
      "label": "失败记录",
      "kinds": [
        "render_failed",
        "import_failed"
      ],
      "format": "entry"
    }
  ],
  "restore": {
    "label": "恢复",
    "action": "restore"
  },
  "archive": {
    "label": "建档"
  },
  "document": {
    "dirty": "Krita 未保存",
    "saved": "Krita 已保存"
  },
  "pending_decision": "等待 Krita 保存…",
  "ports": {
    "input": [
      "pen",
      "decision"
    ],
    "output": [
      "preview",
      "archive"
    ]
  },
  "health": {
    "adapter": "Krita 未连接",
    "pipeline": "容器管线不可用",
    "pose": "位姿流已断开"
  }
}
